rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Painel admin: e-mail verificado E login pelo Google (impede conta e-mail/senha com o mesmo e-mail).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'gomesmartins2302@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Lista de convidados: só e-mails em allowedEmails/{e-mail em minúsculas} usam o app.
    // O admin gerencia a lista; cada usuário só consegue consultar o próprio e-mail.
    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }
    function isAllowed() {
      return isAdmin()
        || (signedIn() && myEmail() != ''
            && exists(/databases/$(database)/documents/allowedEmails/$(myEmail())));
    }
    match /allowedEmails/{email} {
      allow get: if signedIn() && (isAdmin() || email == myEmail());
      allow list, create, update, delete: if isAdmin();
    }

    // Aviso global: o admin publica, qualquer convidado lê.
    match /config/{docId} {
      allow get: if docId == 'announcement' && isAllowed();
      allow create, update, delete: if docId == 'announcement' && isAdmin()
        && (request.method == 'delete'
            || (request.resource.data.keys().hasOnly(['text', 'updatedAt'])
                && request.resource.data.text is string && request.resource.data.text.size() <= 300));
    }

    // Dados financeiros: somente o próprio usuário, só nos 6 documentos que o app usa,
    // com formato { v: ... } e limites de tamanho (o teto do Firestore é 1 MB por documento).
    function validDocId(docId) {
      return docId in ['entries', 'dividas', 'cards', 'purchases', 'faturas', 'settings'];
    }
    function validData() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v'])
        && (!(d.v is list) || d.v.size() <= 20000)
        && (!(d.v is map) || d.v.size() <= 2000);
    }
    match /users/{uid}/data/{docId} {
      allow read: if signedIn() && request.auth.uid == uid && validDocId(docId) && isAllowed();
      allow delete: if signedIn() && request.auth.uid == uid && validDocId(docId); // exclusão de conta vale mesmo se revogado
      allow create, update: if signedIn() && request.auth.uid == uid && validDocId(docId) && validData() && isAllowed();
    }

    // Perfil: cada um lê/grava só o seu, com campos fixos e e-mail igual ao do token
    // (impede forjar o e-mail do admin). Listar todos: só o admin.
    function validProfile(uid) {
      let p = request.resource.data;
      return p.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastLogin', 'createdAt', 'provider', 'emailVerified', 'fcmToken', 'fcmUpdated'])
        && (!('uid' in p) || p.uid == uid)
        && (!('email' in p) || p.email == '' || p.email == request.auth.token.get('email', ''))
        && (!('displayName' in p) || (p.displayName is string && p.displayName.size() <= 200))
        && (!('photoURL' in p) || (p.photoURL is string && p.photoURL.size() <= 2000))
        && (!('emailVerified' in p) || p.emailVerified is bool)
        && (!('provider' in p) || (p.provider is string && p.provider.size() <= 50))
        && (!('fcmToken' in p) || p.fcmToken == null || (p.fcmToken is string && p.fcmToken.size() <= 4096));
    }
    match /userProfiles/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validProfile(uid);
      allow get, list: if isAdmin();
    }

    // Todo o resto fechado (o cron de notificações usa Admin SDK e ignora as regras).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
